# Copie este archivo a .env y complete con su buzón MXroute (solo formulario web).
# En el panel MXroute: Email Accounts → crear buzón dedicado (ej. webform@tudominio.com).

# Servidor SMTP (panel MXroute → "SMTP Settings", suele ser algo como everest.mxrouting.net)
SMTP_HOST=everest.mxrouting.net
SMTP_PORT=587
SMTP_ENCRYPTION=tls

# Credenciales del buzón exclusivo
SMTP_USER=webform@transportesmacotours.com
SMTP_PASS=

# Destino: bandeja donde llegan los mensajes del sitio
MAIL_TO=contacto@transportesmacotours.com

# Remitente (debe ser el mismo buzón SMTP_USER o un alias autorizado)
MAIL_FROM=webform@transportesmacotours.com
MAIL_FROM_NAME=Maco Tours - Formulario web

# true solo en desarrollo local (muestra detalle del error SMTP en JSON)
APP_DEBUG=false

# Errores del sitio (PHP + aplicación): var/logs/error.log vía config/errorlog.php

# Google Tag Manager (todas las páginas vía includes/head.php y layout-start.php)
GTM_CONTAINER_ID=GTM-TNRLBG4W

# Google Analytics 4 (solo se activa si el usuario acepta cookies analíticas)
# Si GA está configurado dentro de GTM, deje esto vacío para evitar duplicar mediciones.
# Ejemplo: G-XXXXXXXXXX
GOOGLE_ANALYTICS_ID=
